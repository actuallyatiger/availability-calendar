# Public URL people use to reach the app (no trailing slash).
# The OIDC redirect URI to register with your provider is: <APP_URL>/api/auth/callback
APP_URL=http://localhost:3000

# Random string, at least 32 chars. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Authentication ----
# "oidc" (default) or "dev" (no password, pick any username - local testing only!)
AUTH_MODE=oidc

# Issuer URL. For Authentik: https://authentik.example.com/application/o/<app-slug>/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Claim holding the user's groups (Authentik includes "groups" with the profile scope)
# OIDC_GROUPS_CLAIM=groups
# Optional comma-separated list; if set, only members of these groups can sign in.
# OIDC_ALLOWED_GROUPS=
# Optional: members of this group can edit/archive/delete any event.
# ADMIN_GROUP=

# ---- Database ----
# Default in Docker is SQLite at /data/app.db. To use your own PostgreSQL:
# DATABASE_URL=postgres://user:pass@host:5432/availability
# Or use the bundled one (docker-compose.postgres.yml) and set:
# POSTGRES_PASSWORD=

# ---- Misc ----
# SESSION_TTL_DAYS=30
# LOG_LEVEL=info
# Trust X-Forwarded-* headers from a reverse proxy (default true)
# TRUST_PROXY=true
